{
  "expo": {
    "name": "PARADA",
    "slug": "parada-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "scheme": "parada",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parada.mobile"
    },
    "android": {
      "package": "com.parada.mobile",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}