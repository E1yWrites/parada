{
  "expo": {
    "name": "PARADA",
    "slug": "parada-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "scheme": "parada",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parada.mobile"
    },
    "android": {
      "package": "com.parada.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PARADA uses your location to help you navigate to the parking area."
        }
      ]
    ]
  }
}