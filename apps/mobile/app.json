{
  "expo": {
    "name": "PARADA",
    "slug": "parada-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "scheme": "parada",
    "icon": "./assets/brand/icon-1024.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parada.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.parada.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon-foreground.png",
        "backgroundColor": "#273248"
      },
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PARADA uses your location to help you navigate to the parking area."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PARADA uses your photo library to let you choose a profile picture.",
          "cameraPermission": "PARADA uses the camera to let you take a profile picture."
        }
      ]
    ]
  }
}
