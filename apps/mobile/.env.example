# ============================================================================
# PARADA Mobile environment
#
# IMPORTANT:
#   - EXPO_PUBLIC_* values are PUBLIC client configuration. Never put secrets
#     (CAMERA_API_KEY, JWT secrets, DB credentials) in these variables.
#   - Copy this file to `.env` within apps/mobile and fill in your values.
#   - `.env` is gitignored (see repository root .gitignore).
# ============================================================================

# Base URL of the PARADA backend API.
#   - iOS Simulator / web:   http://localhost:4000
#   - Android Emulator:      http://10.0.2.2:4000
#   - Physical device:       http://<your-LAN-IP>:4000  (the phone's localhost
#                            is the phone itself, NOT your dev machine)
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000