{
  "name": "@parada/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "PARADA mobile app (React Native + Expo + TypeScript)",
  "main": "index.js",
  "scripts": {
    "build": "expo export --platform ios --platform android",
    "predev": "node scripts/set-lan-ip.js",
    "dev": "cross-env EXPO_NO_WEB=1 expo start --port 8082",
    "predev:lan": "node scripts/set-lan-ip.js",
    "dev:lan": "cross-env EXPO_NO_WEB=1 expo start --host lan --port 8082",
    "prestart": "node scripts/set-lan-ip.js",
    "start": "cross-env EXPO_NO_WEB=1 expo start --port 8082",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@parada/types": "0.1.0",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~58.0.26",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-import-resolver-typescript": "^3.10.1",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "react-dom": "19.3.0",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  }
}
