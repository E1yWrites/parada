{
  "name": "@parada/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "PARADA mobile app (React Native + Expo + TypeScript)",
  "main": "index.js",
  "scripts": {
    "build": "expo export --platform ios --platform android",
    "predev": "node scripts/set-lan-ip.js",
    "dev": "cross-env EXPO_NO_WEB=1 expo start --port 8082",
    "predev:lan": "node scripts/set-lan-ip.js",
    "dev:lan": "cross-env EXPO_NO_WEB=1 expo start --host lan --port 8082",
    "prestart": "node scripts/set-lan-ip.js",
    "start": "cross-env EXPO_NO_WEB=1 expo start --port 8082",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.2.3",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@parada/types": "0.1.0",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~57.0.22",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.18",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.17",
    "expo-image-picker": "~57.0.17",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.17",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.8.3"
  }
}
