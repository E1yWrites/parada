# Copy to .env or .env.local and set real values. NEVER commit secrets.
#
# IMPORTANT: this is a SERVER-ONLY variable. It is never exposed to the
# browser. The Next.js server uses it as the base URL for the PARADA backend.
# The JWT is stored in an HttpOnly cookie on the server and attached to
# outbound requests to the API. The browser never reads or stores the JWT.
API_BASE_URL="http://localhost:4000"