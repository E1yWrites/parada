# Copy to apps/admin/.env.local (or .env) and set real values. NEVER commit secrets.
#
# IMPORTANT: this is a SERVER-ONLY variable. It is never exposed to the
# browser. The Next.js server uses it as the base URL for the PARADA backend.
# The JWT is stored in an HttpOnly cookie on the server and attached to
# outbound requests to the API. The browser never reads or stores the JWT.
#
# It is the API's URL as seen FROM THE ADMIN SERVER, never from the browser.
# Per case (docs/how-to/configure-environments.md):
#   local dev, LAN demo, offline, LOCAL  http://127.0.0.1:4100  (API on the same host)
#   API on another LAN host              http://<api-LAN-IP>:4100
#   docker-compose.online.yml            set by compose to http://api:4100
#   managed platform (ONLINE / HYBRID)   the API's private URL, or https://api.<domain>
# Prefer 127.0.0.1 over localhost: on Windows localhost resolves to ::1 first
# and the API listens on IPv4.
#
# With NODE_ENV=production (`next start`) the session cookie is Secure, so
# serve Admin over HTTPS on anything other than localhost.
API_BASE_URL="http://127.0.0.1:4100"
