# ============================================================================
# PARADA — ONLINE profile (API + Admin + PostgreSQL hosted remotely, HTTPS)
#
# Same application as the LOCAL profile (.env.local.example); only the
# infrastructure values differ. Vision stays on the facility LAN and posts to
# the public API URL (HYBRID) unless a VPN makes the cameras routable.
#
# HOW TO USE
#   docker-compose.online.yml (single VPS / free cloud VM):
#       cp .env.online.example .env.online   # fill in, never commit
#       docker compose --env-file .env.online -f docker-compose.online.yml up -d --build
#   Managed platforms (Render, Railway, Fly.io, ...): paste the API section
#       into the API service's environment, the Admin section into the Admin
#       service's, and set EXPO_PUBLIC_API_URL in EAS for the mobile build.
#
# Tags:  SERVER ONLY / CLIENT VISIBLE / LOCAL ONLY / ONLINE ONLY  (see .env.local.example)
# Inline `# tag` comments are understood by dotenv (API), Next.js, Expo and
# Docker Compose; strip them when pasting into a systemd EnvironmentFile.
# NEVER commit a filled-in copy of this file.
# ============================================================================

# ---------------------------------------------------------------------------
# Public edge (docker-compose.online.yml -> deploy/Caddyfile)   ONLINE ONLY
# ---------------------------------------------------------------------------
API_DOMAIN=api.example.com                 # SERVER ONLY  DNS A record -> this host
ADMIN_DOMAIN=admin.example.com             # SERVER ONLY  DNS A record -> this host
ACME_EMAIL=ops@example.com                 # SERVER ONLY  Let's Encrypt expiry notices

# ---------------------------------------------------------------------------
# PostgreSQL  (compose: the `postgres` container. Managed DB: skip these and
#              set DATABASE_URL to the provider's connection string.)
# ---------------------------------------------------------------------------
POSTGRES_USER=parada                       # SERVER ONLY
POSTGRES_PASSWORD=change-me                # SERVER ONLY
POSTGRES_DB=parada                         # SERVER ONLY

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV=production                        # SERVER ONLY  ONLINE ONLY: always production
# compose: host `postgres`, port 5432 (container network). Managed DB: the
# provider URL, usually with ?sslmode=require.
DATABASE_URL="postgresql://parada:change-me@postgres:5432/parada?schema=public"   # SERVER ONLY
JWT_SECRET=replace-with-a-long-random-secret   # SERVER ONLY
JWT_ISSUER=parada-api                      # SERVER ONLY
JWT_EXPIRES_IN=1d                          # SERVER ONLY
CAMERA_API_KEY=replace-with-a-random-hex-key   # SERVER ONLY  (also given to every on-site vision runtime)
OCR_PLATE_CONFIDENCE_THRESHOLD=0.5         # SERVER ONLY
# ONLINE ONLY: the API always sits behind a TLS proxy/load balancer online.
# compose sets TRUST_PROXY=1 itself (Caddy is one hop); on a managed platform
# set it to that platform's hop count (usually 1).
TRUST_PROXY=1
AUTH_RATE_LIMIT=10                         # SERVER ONLY
CAMERA_EVENT_RATE_LIMIT=300                # SERVER ONLY
ADMIN_RATE_LIMIT=120                       # SERVER ONLY
REALTIME_MAX_CONNECTIONS_PER_USER=5        # SERVER ONLY
REALTIME_REPLAY_BUFFER_SIZE=500            # SERVER ONLY
MAIL_TRANSPORT=smtp                        # SERVER ONLY  (console/memory are refused in production)
SMTP_HOST=smtp.example.com                 # SERVER ONLY
SMTP_PORT=587                              # SERVER ONLY
SMTP_SECURE=false                          # SERVER ONLY  true only for implicit TLS on 465
SMTP_USER=                                 # SERVER ONLY
SMTP_PASS=                                 # SERVER ONLY
MAIL_FROM="PARADA <no-reply@example.com>"  # SERVER ONLY
APP_NAME=PARADA                            # SERVER ONLY
MAIL_ORGANIZATION="LPU-Batangas Main Campus"   # SERVER ONLY
MOBILE_APP_SCHEME=parada                   # SERVER ONLY

# ---------------------------------------------------------------------------
# Admin  (compose sets API_BASE_URL=http://api:4100 itself; on a managed
#         platform set it to the API's PRIVATE or public HTTPS URL)
# ---------------------------------------------------------------------------
# API_BASE_URL=https://api.example.com     # SERVER ONLY  ONLINE ONLY

# ---------------------------------------------------------------------------
# Mobile  (EAS build-time env, or apps/mobile/.env on the build machine)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=https://api.example.com    # CLIENT VISIBLE  ONLINE ONLY: public HTTPS URL, no trailing slash

# ---------------------------------------------------------------------------
# Vision  (on-site runtime, HYBRID; or the `vision-demo` compose profile)
# ---------------------------------------------------------------------------
PARADA_API_URL=https://api.example.com     # SERVER ONLY  ONLINE ONLY: public HTTPS API (compose demo overrides to http://api:4100)
# CAMERA_API_KEY=<same value as the API>   # SERVER ONLY
CAMERA_IDENTIFIER=CAM-A01                  # SERVER ONLY
CAMERA_ZONE_ID=                            # SERVER ONLY  (zone id from Admin -> Zones; required)
CAMERA_SOURCE=rtsp                         # SERVER ONLY  usb | rtsp | file   (the demo profile forces `file`)
VIDEO_SOURCE=rtsp://user:password@192.168.1.50:554/stream1   # SERVER ONLY  LOCAL ONLY: RTSP never leaves the facility LAN
CAMERA_DEVICE_INDEX=0                      # SERVER ONLY
CAMERA_FILE_PATH=                          # SERVER ONLY
VISION_PROCESS_FPS=2                       # SERVER ONLY
OBSERVATION_COOLDOWN_SECONDS=5             # SERVER ONLY
CAMERA_RECONNECT_DELAY_SECONDS=2           # SERVER ONLY
MAX_CONSECUTIVE_READ_FAILURES=10           # SERVER ONLY
MAX_FORWARD_ATTEMPTS=3                     # SERVER ONLY
MAX_CAMERA_RECONNECTS=100                  # SERVER ONLY
