# Environment variables - NEVER commit secrets. Only the *.example templates
# (.env.example, .env.local.example, .env.online.example, per-package
# .env.example) are tracked; every filled-in variant is ignored.
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store

