# ============================================================================
# PARADA Environment Variable Conventions
#
# IMPORTANT:
#   - NEVER commit real secrets.
#   - Copy this file to `.env` within the relevant package and fill values.
#   - Each package may define its own `.env.example` with package-specific vars.
#   - Deployment profiles: `.env.local.example` (LOCAL / on-premise) and
#     `.env.online.example` (ONLINE / HYBRID) list every variable per profile
#     with SERVER ONLY / CLIENT VISIBLE tags — see docs/how-to/deploy.md.
# ============================================================================

# PostgreSQL
POSTGRES_USER=parada
POSTGRES_PASSWORD=changeme
POSTGRES_DB=parada
POSTGRES_PORT=5442

# Backend API
DATABASE_URL="postgresql://parada:changeme@localhost:5442/parada?schema=public"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
PORT=4100

# Vision service
VISION_PORT=5000

# Admin web (server-only: the JWT lives in an HttpOnly cookie and the
# browser never sees the API base URL — see apps/admin/lib/auth.ts)
API_BASE_URL=http://localhost:4100

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:4100
