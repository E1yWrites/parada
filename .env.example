# ============================================================================
# PARADA Environment Variable Conventions
#
# IMPORTANT:
#   - NEVER commit real secrets.
#   - Copy this file to `.env` within the relevant package and fill values.
#   - Each package may define its own `.env.example` with package-specific vars.
# ============================================================================

# PostgreSQL
POSTGRES_USER=parada
POSTGRES_PASSWORD=changeme
POSTGRES_DB=parada
POSTGRES_PORT=5432

# Backend API
DATABASE_URL="postgresql://parada:changeme@localhost:5432/parada?schema=public"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
PORT=4000

# Vision service
VISION_PORT=5000

# Admin web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:4000
