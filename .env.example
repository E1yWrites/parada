# ============================================================================
# PARADA - root environment file
#
# Only ONE thing reads the root `.env`: docker-compose.yml (an optional local
# PostgreSQL container), through Docker Compose variable substitution. The
# API, Admin, Mobile and Vision never read this file. Each reads its own:
#
#   services/api/.env          <- services/api/.env.example      (API)
#   apps/admin/.env.local      <- apps/admin/.env.example        (Admin)
#   apps/mobile/.env           <- apps/mobile/.env.example       (Mobile)
#   services/vision/.env       <- services/vision/.env.example   (Vision; export it,
#                                                                 there is no loader)
#   packages/database/.env     <- packages/database/.env.example (Prisma CLI / seed)
#
# Values for every run case (local dev, phone on LAN, offline, tests, LOCAL,
# ONLINE, HYBRID): docs/how-to/configure-environments.md
# Full per-profile reference sheets: .env.local.example, .env.online.example
#
# NEVER commit a filled-in copy. Only *.example files are tracked.
# ============================================================================

# ---------------------------------------------------------------------------
# docker-compose.yml (only needed if you use the container instead of the
# embedded development database started by `npm run db:start`)
# ---------------------------------------------------------------------------
POSTGRES_USER=parada
POSTGRES_PASSWORD=changeme
POSTGRES_DB=parada
# Host port. 5442 matches the embedded database and every DATABASE_URL in the
# templates; stop the embedded database first (`npm run db:stop`), because
# both cannot listen on the same port.
POSTGRES_PORT=5442
