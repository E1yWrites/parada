# Copy to .env within services/vision and set real values.
# NEVER commit .env. Keep secrets out of the repository.
#
# The vision service reads the PROCESS ENVIRONMENT only (app/config.py uses
# os.environ; there is no dotenv loader). A .env file here is a template for
# whatever injects the environment — `set -a; . ./.env; set +a` in a shell,
# a systemd `EnvironmentFile=`, or a container/orchestrator env — not a file
# the service loads by itself.
#
# These are the camera runtime's own settings — separate from services/api's
# CAMERA_API_KEY, which only authenticates vision's HTTP calls to the API.
# Registering a camera also requires the logical camera to exist in
# Admin -> Cameras first (identifier + zone + direction + status) — see
# docs/how-to/add-a-camera.md.

# ---------------------------------------------------------------------------
# API connection
# ---------------------------------------------------------------------------
PARADA_API_URL="http://localhost:4100"
# Must match the API's CAMERA_API_KEY (services/api/.env). Leave unset only
# for trusted local development.
CAMERA_API_KEY=""

# ---------------------------------------------------------------------------
# Frame source — pick ONE via CAMERA_SOURCE
# ---------------------------------------------------------------------------
# usb | rtsp | file
CAMERA_SOURCE="file"

# usb: device index (0, 1, 2, ...)
CAMERA_DEVICE_INDEX="0"

# rtsp: rtsp:// or rtsps:// URL only. Embed credentials in the URL if needed;
# they are redacted (scheme/host/port only) from every response/log.
VIDEO_SOURCE=""

# file: path to a video fixture (see tests/fixtures/generate_video.py)
CAMERA_FILE_PATH=""

# ---------------------------------------------------------------------------
# Logical camera join key — must match the identifier registered in
# Admin -> Cameras (POST /admin/cameras)
# ---------------------------------------------------------------------------
CAMERA_IDENTIFIER="CAM-A01"

# Required for the `run` loop (not `test`). The zone the camera is configured
# under in Admin; the API verifies the camera really belongs to this zone.
CAMERA_ZONE_ID=""

# ---------------------------------------------------------------------------
# Processing / resilience tuning — defaults are usually fine
# ---------------------------------------------------------------------------
# Processing ceiling; frames above this are not OCR'd.
VISION_PROCESS_FPS="2"
# Same camera + same plate + same direction within this window = one observation.
OBSERVATION_COOLDOWN_SECONDS="5"
# Backoff between camera reconnect attempts.
CAMERA_RECONNECT_DELAY_SECONDS="2"
# Consecutive failed frame reads before the runtime treats the source as gone.
MAX_CONSECUTIVE_READ_FAILURES="10"
# Total HTTP attempts per event on 429/5xx/transport failure (same sourceEventId).
MAX_FORWARD_ATTEMPTS="3"
# Reconnect ceiling; beyond this the camera stops cleanly (no crash).
MAX_CAMERA_RECONNECTS="100"

# ---------------------------------------------------------------------------
# Shared with services/api — must use the SAME value on both sides so the
# two services agree on the OCR trust threshold. The actual trust decision
# is made by the API (OccupancyService), not here.
# ---------------------------------------------------------------------------
OCR_PLATE_CONFIDENCE_THRESHOLD="0.5"
