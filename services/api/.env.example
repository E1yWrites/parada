# Copy to .env and set real values.
# NEVER commit .env. Keep secrets out of the repository.
PORT="4100"
HOST="0.0.0.0"
# Default: the embedded development database started by `npm run db:start`.
# Point this at your own server for any other environment.
DATABASE_URL="postgresql://parada:changeme@127.0.0.1:5442/parada?schema=public"
NODE_ENV="development"

# Authentication secret — REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Do not hardcode a real secret in the repository.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_ISSUER="parada-api"
JWT_EXPIRES_IN="1d"

# Shared API key the camera/vision service must present on the event-ingestion
# endpoint (POST /zones/:id/events) via the "X-API-Key" header.
# Leave unset only for trusted local development; set a real secret in any
# deployment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAMERA_API_KEY=""

# Minimum OCR confidence [0..1] for a detected plate to be treated as a reliable
# vehicle identity. Below this, the plate is recorded but no session is created.
OCR_PLATE_CONFIDENCE_THRESHOLD="0.5"

# ---------------------------------------------------------------------------
# Abuse limits. All are per fixed 60s window and PER PROCESS: PARADA runs as a
# single API instance, and nothing coordinates these across two. Do not scale
# the API horizontally without replacing them with a shared limiter.
# ---------------------------------------------------------------------------
# Login / recovery attempts per client key per minute.
AUTH_RATE_LIMIT="10"
# Camera events per camera identifier per minute (a camera at the default
# 2 FPS with plate debounce produces far fewer; retries re-send the same id).
CAMERA_EVENT_RATE_LIMIT="300"
# Admin mutations per admin account per minute.
ADMIN_RATE_LIMIT="120"
# Concurrent SSE streams one account may hold (each open tab/device is one).
REALTIME_MAX_CONNECTIONS_PER_USER="5"
# Events kept for Last-Event-ID replay on reconnect; beyond this a client gets
# a SYNC frame and refetches over REST.
REALTIME_REPLAY_BUFFER_SIZE="500"

# ---------------------------------------------------------------------------
# Outbound mail (registration verification codes, email/phone change codes,
# password-reset tokens). Any SMTP-compatible provider works; nothing is
# hard-coded to a paid service.
#   MAIL_TRANSPORT=smtp     use SMTP_* below (REQUIRED in production)
#   MAIL_TRANSPORT=console  development only: messages are printed to stdout
# Leaving MAIL_TRANSPORT empty selects smtp when SMTP_HOST is set, else console.
MAIL_TRANSPORT="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="PARADA <no-reply@example.com>"
# Product name and establishment shown in outbound mail, and the mobile
# deep-link scheme used in the password-reset message (must match
# apps/mobile/app.json "scheme").
APP_NAME="PARADA"
MAIL_ORGANIZATION="LPU-Batangas Main Campus"
MOBILE_APP_SCHEME="parada"
