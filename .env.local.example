# ============================================================================
# PARADA — LOCAL / ON-PREMISE profile (everything inside the facility)
#
# One application, three deployment profiles (docs/how-to/deploy.md):
#   LOCAL  — this file.      PostgreSQL, API, Admin, Vision on the facility
#                            LAN; phones reach the API over Wi-Fi (or a tunnel).
#   ONLINE — .env.online.example. API/Admin/DB hosted remotely over HTTPS.
#   HYBRID — ONLINE values for API/Admin/DB + LOCAL values for Vision.
#
# HOW TO USE: this is a reference. Each process reads its OWN file:
#   services/api/.env         <- API section         (dotenv, cwd = services/api)
#   apps/admin/.env.local     <- Admin section       (Next.js)
#   apps/mobile/.env          <- Mobile section      (Expo, build time)
#   services/vision           <- Vision section, exported into the process env
#                                (no dotenv loader; `set -a; . ./.env; set +a`)
#
# Tags:  SERVER ONLY  = never leaves the server process
#        CLIENT VISIBLE = compiled into the mobile app; never a secret
#        LOCAL ONLY / ONLINE ONLY = value differs by profile
# Inline `# tag` comments are understood by dotenv (API), Next.js, Expo and
# Docker Compose; strip them when pasting into a systemd EnvironmentFile.
# NEVER commit a filled-in copy of this file.
# ============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL  (LOCAL ONLY: embedded dev DB `npm run db:start`, or
#              docker-compose.yml, or a facility PostgreSQL server)
# ---------------------------------------------------------------------------
POSTGRES_USER=parada                       # SERVER ONLY
POSTGRES_PASSWORD=change-me                # SERVER ONLY
POSTGRES_DB=parada                         # SERVER ONLY
POSTGRES_PORT=5442                         # SERVER ONLY

# ---------------------------------------------------------------------------
# API  -> services/api/.env
# ---------------------------------------------------------------------------
NODE_ENV=production                        # SERVER ONLY  (production enables every guard; development only on a dev box)
HOST=0.0.0.0                               # SERVER ONLY  (bind every LAN interface so phones can connect)
PORT=4100                                  # SERVER ONLY
DATABASE_URL="postgresql://parada:change-me@127.0.0.1:5442/parada?schema=public"   # SERVER ONLY
JWT_SECRET=replace-with-a-long-random-secret   # SERVER ONLY  (node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_ISSUER=parada-api                      # SERVER ONLY
JWT_EXPIRES_IN=1d                          # SERVER ONLY
CAMERA_API_KEY=replace-with-a-random-hex-key   # SERVER ONLY  (shared with every vision runtime; required when NODE_ENV=production)
OCR_PLATE_CONFIDENCE_THRESHOLD=0.5         # SERVER ONLY  (same value on the vision side)
# LOCAL ONLY: unset — phones and Admin reach the API directly, no proxy hop.
# Set TRUST_PROXY=1 only when a tunnel or reverse proxy sits in front (docs/how-to/deploy-local.md).
TRUST_PROXY=
AUTH_RATE_LIMIT=10                         # SERVER ONLY
CAMERA_EVENT_RATE_LIMIT=300                # SERVER ONLY
ADMIN_RATE_LIMIT=120                       # SERVER ONLY
REALTIME_MAX_CONNECTIONS_PER_USER=5        # SERVER ONLY
REALTIME_REPLAY_BUFFER_SIZE=500            # SERVER ONLY
# Mail: real SMTP is required when NODE_ENV=production (console is refused).
MAIL_TRANSPORT=smtp                        # SERVER ONLY
SMTP_HOST=smtp.example.com                 # SERVER ONLY
SMTP_PORT=587                              # SERVER ONLY
SMTP_SECURE=false                          # SERVER ONLY
SMTP_USER=                                 # SERVER ONLY
SMTP_PASS=                                 # SERVER ONLY
MAIL_FROM="PARADA <no-reply@example.com>"  # SERVER ONLY
APP_NAME=PARADA                            # SERVER ONLY
MAIL_ORGANIZATION="LPU-Batangas Main Campus"   # SERVER ONLY
MOBILE_APP_SCHEME=parada                   # SERVER ONLY (must equal apps/mobile/app.json "scheme")

# ---------------------------------------------------------------------------
# Admin  -> apps/admin/.env.local
# ---------------------------------------------------------------------------
API_BASE_URL=http://127.0.0.1:4100         # SERVER ONLY  (URL of the API as seen from the Admin server, never from the browser)
# LOCAL ONLY note: with NODE_ENV=production the session cookie is `Secure`, so
# serve Admin over HTTPS (tunnel, or a LAN reverse proxy with a certificate) or
# run it with NODE_ENV=development for a plain-HTTP LAN demo.

# ---------------------------------------------------------------------------
# Mobile  -> apps/mobile/.env  (build time; baked into the app)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://192.168.1.10:4100   # CLIENT VISIBLE  LOCAL ONLY: the API host's LAN address (never localhost)

# ---------------------------------------------------------------------------
# Vision  (one environment per camera process; exported, not auto-loaded)
# ---------------------------------------------------------------------------
PARADA_API_URL=http://127.0.0.1:4100       # SERVER ONLY  LOCAL ONLY: LAN address of the API
# CAMERA_API_KEY=<same value as the API>   # SERVER ONLY
CAMERA_IDENTIFIER=CAM-A01                  # SERVER ONLY  (as registered in Admin -> Cameras)
CAMERA_ZONE_ID=                            # SERVER ONLY  (zone id the camera belongs to)
CAMERA_SOURCE=rtsp                         # SERVER ONLY  usb | rtsp | file
VIDEO_SOURCE=rtsp://user:password@192.168.1.50:554/stream1   # SERVER ONLY  LOCAL ONLY (RTSP stays on the LAN; redacted in logs)
CAMERA_DEVICE_INDEX=0                      # SERVER ONLY  (usb)
CAMERA_FILE_PATH=                          # SERVER ONLY  (file)
VISION_PROCESS_FPS=2                       # SERVER ONLY
OBSERVATION_COOLDOWN_SECONDS=5             # SERVER ONLY
CAMERA_RECONNECT_DELAY_SECONDS=2           # SERVER ONLY
MAX_CONSECUTIVE_READ_FAILURES=10           # SERVER ONLY
MAX_FORWARD_ATTEMPTS=3                     # SERVER ONLY
MAX_CAMERA_RECONNECTS=100                  # SERVER ONLY
