// PARADA database schema
// Authoritative data model for the PostgreSQL database.
//
// Architecture decisions reflected here (see docs/database/model.md):
// - Zone-level occupancy is the authoritative metric.
// - ParkingSlot is physical inventory only (layout/visual); NOT camera-derived occupancy.
// - Occupancy changes happen through OccupancyEvent (ENTRY/EXIT), applied transactionally.
// - OccupancyHistory preserves immutable snapshots for analytics/testing/audit.
// - ParkingSession is vehicle-identified (linked to User + Vehicle via OCR/plate matching).
// - available_count is derived (capacity - occupied_count) and never stored.
// - occupied_count is cached on ParkingZone (O(1) reads), DB-constrained to [0, capacity].

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ZoneStatus {
  ACTIVE
  INACTIVE
}

enum SlotStatus {
  ACTIVE
  INACTIVE
}

enum CameraStatus {
  ONLINE
  OFFLINE
}

enum GateType {
  ENTRY
  EXIT
  BIDIRECTIONAL
}

enum OccupancyEventType {
  ENTRY
  EXIT
}

enum OccupancySource {
  CAMERA
  SIMULATOR
  MANUAL
}

enum ParkingSessionStatus {
  ACTIVE
  COMPLETED
}

enum VehicleType {
  CAR
  MOTORCYCLE
  VAN
  TRUCK
  OTHER
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
}

enum NotificationType {
  ZONE_FULL
  ZONE_LOW_AVAILABILITY
  RESERVATION_EXPIRING
  GUEST_ADMISSION_ISSUE
  WRONG_ZONE_WARNING
  VIOLATION_ISSUED
  VIOLATION_APPEAL_SUBMITTED
  VIOLATION_APPEAL_RESULT
}

enum ViolationType {
  WRONG_ZONE
  OVERSTAY
  UNAUTHORIZED
  GATE_TAMPERING
}

enum ViolationStatus {
  PENDING
  APPEALED
  UPHELD
  DISMISSED
  FINE_PAID
}

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ACTIVE
  EXPIRED
  CANCELLED
}

enum FeeStatus {
  PENDING
  PAID
  WAIVED
}

enum ZoneAssignmentStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  vehicles         Vehicle[]
  sessions         ParkingSession[]
  reservations     Reservation[]
  zoneAssignments  ZoneAssignment[]
  violations       Violation[]
  violationAppeals ViolationAppeal[]
  parkingFees      ParkingFee[]
  notifications    Notification[]

  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Vehicle  (user-owned; the primary identity for the OCR/plate workflow)
// ---------------------------------------------------------------------------

model Vehicle {
  id              String        @id @default(cuid())
  userId          String
  plateNumber     String
  normalizedPlate String
  vehicleType     VehicleType   @default(CAR)
  status          VehicleStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions        ParkingSession[]
  events          OccupancyEvent[]
  anomalies       OccupancyAnomaly[]
  reservations    Reservation[]
  zoneAssignments ZoneAssignment[]
  violations      Violation[]

  @@unique([userId, normalizedPlate])
  @@index([normalizedPlate])
  @@index([userId])
  @@map("vehicles")
}

// ---------------------------------------------------------------------------
// ParkingZone
// ---------------------------------------------------------------------------

model ParkingZone {
  id            String     @id @default(cuid())
  name          String     @unique
  code          String     @unique
  description   String?
  capacity      Int
  occupiedCount Int        @default(0)
  status        ZoneStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  slots            ParkingSlot[]
  cameras          Camera[]
  occupancyEvents  OccupancyEvent[]
  occupancyHistory OccupancyHistory[]
  parkingSessions  ParkingSession[]
  notifications    Notification[]
  reservations     Reservation[]
  zoneAssignments  ZoneAssignment[]
  violations       Violation[]
  parkingFees      ParkingFee[]

  @@index([status])
  @@map("parking_zones")
}

// ---------------------------------------------------------------------------
// ParkingSlot  (physical/logical inventory only - NOT camera-derived occupancy)
// ---------------------------------------------------------------------------

model ParkingSlot {
  id        String     @id @default(cuid())
  zoneId    String
  slotCode  String
  label     String
  positionX Int?
  positionY Int?
  status    SlotStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  zone ParkingZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@unique([zoneId, slotCode])
  @@index([zoneId])
  @@map("parking_slots")
}

// ---------------------------------------------------------------------------
// Camera
// ---------------------------------------------------------------------------

model Camera {
  id         String       @id @default(cuid())
  zoneId     String
  name       String
  identifier String       @unique
  location   String?
  gateType   GateType     @default(BIDIRECTIONAL)
  status     CameraStatus @default(OFFLINE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  zone            ParkingZone        @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  occupancyEvents OccupancyEvent[]
  anomalies       OccupancyAnomaly[]

  @@index([zoneId])
  @@map("cameras")
}

// ---------------------------------------------------------------------------
// OccupancyEvent  (the critical single write-point for occupancy changes)
// ---------------------------------------------------------------------------

model OccupancyEvent {
  id               String             @id @default(cuid())
  zoneId           String
  cameraId         String?
  eventType        OccupancyEventType
  previousOccupied Int
  newOccupied      Int
  availableCount   Int
  source           OccupancySource    @default(CAMERA)
  // client-supplied id for idempotency; unique per camera via @@unique
  sourceEventId    String?
  // Vehicle identification result (plate recognition / OCR). Optional: an
  // event is still valid even when no registered vehicle is matched.
  vehicleId        String?
  detectedPlate    String?
  normalizedPlate  String?
  ocrConfidence    Float?
  plateMatched     Boolean?
  detectedAt       DateTime
  processedAt      DateTime           @default(now())
  createdAt        DateTime           @default(now())

  zone    ParkingZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  camera  Camera?     @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  vehicle Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  sessionAsEntry ParkingSession? @relation("SessionEntry")
  sessionAsExit  ParkingSession? @relation("SessionExit")

  anomaly OccupancyAnomaly?

  @@unique([cameraId, sourceEventId])
  @@index([zoneId, detectedAt])
  @@index([eventType])
  @@index([vehicleId])
  @@map("occupancy_events")
}

// ---------------------------------------------------------------------------
// OccupancyAnomaly  (anomalies in the physical/identity pipeline that must be
// retained for administrative review without fabricating data)
//
// Used to record e.g. an EXIT whose plate does not match an ACTIVE session, a
// low-confidence plate, or any mismatch between the physical occupancy signal
// and the registered-vehicle identity. Physical occupancy is still updated; the
// anomaly is kept separate for audit.
// ---------------------------------------------------------------------------

model OccupancyAnomaly {
  id               String   @id @default(cuid())
  occupancyEventId String   @unique @default(cuid())
  cameraId         String?
  vehicleId        String?
  detectedPlate    String?
  anomalyType      String
  description      String?
  resolved         Boolean  @default(false)
  createdAt        DateTime @default(now())

  event   OccupancyEvent? @relation(fields: [occupancyEventId], references: [id], onDelete: Cascade)
  camera  Camera?         @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  vehicle Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([anomalyType])
  @@index([resolved])
  @@map("occupancy_anomalies")
}

// ---------------------------------------------------------------------------
// OccupancyHistory  (immutable snapshot of zone occupancy state)
// ---------------------------------------------------------------------------

model OccupancyHistory {
  id             String   @id @default(cuid())
  zoneId         String
  occupiedCount  Int
  availableCount Int
  occurredAt     DateTime @default(now())

  zone ParkingZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@index([zoneId, occurredAt])
  @@map("occupancy_history")
}

// ---------------------------------------------------------------------------
// ParkingSession  (vehicle-identified parking presence; a real session only
// exists when a registered vehicle matches the detected plate)
// ---------------------------------------------------------------------------

model ParkingSession {
  id              String               @id @default(cuid())
  zoneId          String
  // Optional for GUEST sessions (account-less walk-ins). Registered parking
  // sessions always set a valid user/vehicle.
  userId          String?
  vehicleId       String?
  entryEventId    String               @unique
  exitEventId     String?              @unique
  enteredAt       DateTime
  exitedAt        DateTime?
  durationSeconds Int?
  feeAmount       Float?
  status          ParkingSessionStatus @default(ACTIVE)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  zone         ParkingZone     @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  entryEvent   OccupancyEvent  @relation("SessionEntry", fields: [entryEventId], references: [id], onDelete: Restrict)
  exitEvent    OccupancyEvent? @relation("SessionExit", fields: [exitEventId], references: [id], onDelete: SetNull)
  fee          ParkingFee?
  guestSession GuestSession?
  violations   Violation[]

  @@index([zoneId, status])
  @@index([vehicleId, status])
  @@index([userId])
  @@index([enteredAt])
  @@map("parking_sessions")
}

// ---------------------------------------------------------------------------
// Notification  (admin + driver alerts; minimal)
// ---------------------------------------------------------------------------

model Notification {
  id         String           @id @default(cuid())
  zoneId     String
  userId     String?
  type       NotificationType
  message    String
  targetRole Role
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  zone ParkingZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  user User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([targetRole, read])
  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// EstablishmentConfig  (singleton row for runtime-configurable settings)
// ---------------------------------------------------------------------------

model EstablishmentConfig {
  id           String   @id @default(cuid())
  parkingFee   Json
  violations   Json
  guestPolicy  Json
  zoneDefaults Json
  // Optional establishment navigation destination (Phase 9.5). Null/absent
  // until an admin configures a real address/coordinates; the API never
  // fabricates a location.
  location     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("establishment_config")
}

// ---------------------------------------------------------------------------
// Reservation  (pre-booked parking with a configurable arrival window)
// ---------------------------------------------------------------------------

model Reservation {
  id        String            @id @default(cuid())
  userId    String
  vehicleId String
  zoneId    String
  startAt   DateTime
  endAt     DateTime
  status    ReservationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  zone    ParkingZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  guestSession GuestSession?

  @@index([userId])
  @@index([vehicleId])
  @@index([zoneId, status])
  @@index([startAt, endAt])
  @@map("reservations")
}

// ---------------------------------------------------------------------------
// ZoneAssignment  (user/vehicle assigned to a zone for wrong-zone detection)
// ---------------------------------------------------------------------------

model ZoneAssignment {
  id         String               @id @default(cuid())
  userId     String
  vehicleId  String
  zoneId     String
  status     ZoneAssignmentStatus @default(ACTIVE)
  assignedAt DateTime             @default(now())
  expiresAt  DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  zone    ParkingZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([vehicleId])
  @@index([zoneId, status])
  @@map("zone_assignments")
}

// ---------------------------------------------------------------------------
// Violation  (wrong-zone, overstay, unauthorized, gate tampering)
// ---------------------------------------------------------------------------

model Violation {
  id            String          @id @default(cuid())
  userId        String
  vehicleId     String?
  zoneId        String
  sessionId     String?
  violationType ViolationType
  description   String?
  fineAmount    Float
  status        ViolationStatus @default(PENDING)
  issuedAt      DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicle Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  zone    ParkingZone      @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  session ParkingSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  appeal  ViolationAppeal?

  @@index([userId])
  @@index([vehicleId])
  @@index([zoneId])
  @@index([status])
  @@index([violationType])
  @@map("violations")
}

// ---------------------------------------------------------------------------
// ViolationAppeal  (user appeal of a violation)
// ---------------------------------------------------------------------------

model ViolationAppeal {
  id          String       @id @default(cuid())
  violationId String       @unique
  userId      String
  reason      String
  status      AppealStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  violation Violation @relation(fields: [violationId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@map("violation_appeals")
}

// ---------------------------------------------------------------------------
// ParkingFee  (fee records for completed sessions)
// ---------------------------------------------------------------------------

model ParkingFee {
  id            String    @id @default(cuid())
  sessionId     String    @unique
  zoneId        String
  userId        String
  amount        Float
  rateBreakdown Json
  paidAt        DateTime?
  status        FeeStatus @default(PENDING)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  session ParkingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  zone    ParkingZone    @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  user    User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([zoneId])
  @@index([userId])
  @@index([status])
  @@map("parking_fees")
}

// ---------------------------------------------------------------------------
// GuestSession  (guest/walk-in parking; wraps a ParkingSession)
// ---------------------------------------------------------------------------

model GuestSession {
  id                  String   @id @default(cuid())
  parkingSessionId    String   @unique
  detectedPlate       String?
  linkedReservationId String?  @unique
  createdAt           DateTime @default(now())

  session     ParkingSession @relation(fields: [parkingSessionId], references: [id], onDelete: Restrict)
  reservation Reservation?   @relation(fields: [linkedReservationId], references: [id], onDelete: SetNull)

  @@index([detectedPlate])
  @@map("guest_sessions")
}

// ---------------------------------------------------------------------------
// RevokedToken  (server-side JWT revocation / logout invalidation)
// The stateless JWT is invalidated by recording its unique token id (jti) here.
// Every authenticated request rejects tokens whose jti is present. This makes
// logout a real server-side invalidation rather than just discarding the token.
// ---------------------------------------------------------------------------

model RevokedToken {
  id        String   @id @default(cuid())
  tokenId   String   @unique
  revokedAt DateTime @default(now())

  @@map("revoked_tokens")
}
