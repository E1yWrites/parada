{
  "extends": "@parada/config/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // Plain CommonJS: the generated Prisma client's dynamic import() of its
    // WASM query compiler then compiles to require(), which Jest can load
    // without --experimental-vm-modules.
    "module": "CommonJS",
    "moduleResolution": "Node10"
  },
  "include": ["src/**/*"]
}
