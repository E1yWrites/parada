# Copy to packages/database/.env. Read by the Prisma CLI and by the seed
# (dotenv) when they run from this package. NEVER commit the filled-in copy.
#
# The npm scripts db:migrate, db:reset, db:test:setup, seed and test set
# DATABASE_URL themselves (embedded database on 127.0.0.1:5442), so this file
# only matters for `migrate:dev`, `migrate:deploy`, direct `npx prisma ...`
# commands and the seed passwords below.
#
# Per case (docs/how-to/configure-environments.md):
#   local dev / offline   the embedded database below (`npm run db:start`)
#   LOCAL deployment      the facility PostgreSQL server
#   ONLINE / HYBRID       the provider's URL, usually with ?sslmode=require
# Always migrate with `prisma migrate deploy`, never `prisma db push`: some
# integrity constraints exist only in the migration SQL.
DATABASE_URL="postgresql://parada:changeme@127.0.0.1:5442/parada?schema=public"

# Seed accounts (admin@parada.local / driver@parada.local). The seed refuses
# to run without both outside NODE_ENV=test and never prints them.
# PARADA_SEED_ADMIN_PASSWORD=
# PARADA_SEED_USER_PASSWORD=
