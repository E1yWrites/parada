{
  "name": "@parada/database",
  "version": "0.1.0",
  "private": true,
  "description": "PARADA database package (Prisma schema + access + seed)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "generate": "prisma generate",
    "format": "prisma format",
    "validate": "prisma validate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "cross-env DATABASE_URL=\"postgresql://parada:changeme@127.0.0.1:5442/parada?schema=public\" ts-node src/seed/index.ts",
    "db:dev": "node scripts/start-dev-db.cjs",
    "db:start": "node scripts/start-dev-db-background.cjs",
    "db:stop": "node scripts/stop-dev-db.cjs",
    "db:migrate": "cross-env DATABASE_URL=\"postgresql://parada:changeme@127.0.0.1:5442/parada?schema=public\" prisma migrate deploy",
    "db:reset": "cross-env DATABASE_URL=\"postgresql://parada:changeme@127.0.0.1:5442/parada?schema=public\" prisma migrate reset --force && npm run seed",
    "db:test:setup": "node scripts/setup-test-db.cjs && cross-env DATABASE_URL=\"postgresql://parada:changeme@127.0.0.1:5442/parada_test?schema=public\" prisma migrate deploy && cross-env DATABASE_URL=\"postgresql://parada:changeme@127.0.0.1:5442/parada_test_api?schema=public\" prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "cross-env DATABASE_URL=\"postgresql://parada:changeme@127.0.0.1:5442/parada_test?schema=public\" jest"
  },
  "dependencies": {
    "@parada/config": "0.1.0",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "dotenv": "^18.0.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "jest": "^30.5.2",
    "prisma": "7.10.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "eslint": "^10.0.0"
  }
}
