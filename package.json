{
  "name": "parada",
  "version": "0.1.0",
  "private": true,
  "description": "PARADA: A Mobile and Web-Based Smart Parking System for Zone-Based Occupancy Detection Using OCR-Assisted Cameras",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/run-dev.cjs",
    "dev:api": "npm run db:prepare && npx turbo run build --filter=@parada/api && npm run start -w @parada/api",
    "dev:admin": "npm run dev -w @parada/admin",
    "dev:mobile": "npm run dev:lan -w @parada/mobile",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "run": "npm run dev",
    "db:start": "npm run db:start -w @parada/database",
    "db:prepare": "npm run db:start && npm run db:migrate -w @parada/database",
    "db:stop": "npm run db:stop -w @parada/database",
    "db:reset": "npm run db:start && npm run db:reset -w @parada/database",
    "postinstall": "node scripts/ensure-expo-link.cjs"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "turbo": "^2.3.0"
  },
  "packageManager": "npm@9.2.0",
  "overrides": {
    "postcss": "^8.5.28"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "argon2@0.45.1": true,
    "prisma@5.22.0": true,
    "unrs-resolver@1.12.2": true
  }
}
